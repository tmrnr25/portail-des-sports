---
import Base from "../../../layouts/Base.astro";
import { SPORTS, getSport, plural } from "../../../lib/sport.js";
export function getStaticPaths() {
  return SPORTS.flatMap((cfg) => Object.entries(cfg.groups).map(([g, gc]) => ({ params: { sport: cfg.key, group: gc.path }, props: { g } })));
}
const { g } = Astro.props;
const s = getSport(Astro.params.sport);
const { cfg } = s;
const gc = cfg.groups[g];
const rows = s.groups[g]
  .map((x) => ({ x: { ...x, group: g }, st: s.stats.get(x.id) }))
  .sort((a, b) => b.st.wins - a.st.wins || b.st.podiums - a.st.podiums || b.st.awards.length - a.st.awards.length || a.x.name.localeCompare(b.x.name, "fr"));
const hasRetired = rows.some((r) => r.x.retired);
const hasAwards = rows.some((r) => r.st.awards.length);
const hasResults = rows.some((r) => r.st.results.length);
---
<Base title={`${gc.label} · ${cfg.label}`} nav={cfg.key}>
  <header class="band hero noart" style="background:var(--nuit)">
    <div class="wrap">
      <div>
        <div class="crumb"><a href={s.url.home}>{cfg.label}</a> › {gc.label}</div>
        <h1>{gc.label}</h1>
        <p>{plural(rows.length, gc.one)}{hasResults ? ", classés par victoires puis par podiums." : "."}</p>
      </div>
    </div>
  </header>
  <section class="band">
    <div class="wrap">
      {rows.length === 0 ? <p class="muted">Aucune fiche pour l'instant.</p> : (
        <>
          <div class="tools">
            <input type="search" id="q" placeholder="Chercher un nom ou un pays" aria-label="Chercher un nom ou un pays" />
            {hasRetired && (
              <div class="seg" id="seg">
                <button data-f="all" aria-pressed="true">Tous</button>
                <button data-f="actif" aria-pressed="false">En activité</button>
                <button data-f="retraite" aria-pressed="false">Retraités</button>
              </div>
            )}
            <span class="count" id="count">{plural(rows.length, gc.one)}</span>
          </div>
          <table class="stack" id="pl">
            <thead><tr><th>Nom</th><th>Pays</th>{hasResults && <th class="num">Victoires</th>}{hasResults && <th class="num">Podiums</th>}{hasAwards && <th class="num">{s.awardWord.title}</th>}</tr></thead>
            <tbody>
              {rows.map(({ x, st }) => (
                <tr data-s={`${x.name} ${x.nat?.name || ""}`.toLowerCase()} data-f={x.retired ? "retraite" : "actif"}>
                  <td>{s.hasPage(x) ? <a href={s.url.entity(x)}>{x.name}</a> : x.name}</td>
                  <td>{x.nat ? `${x.nat.emoji} ${x.nat.name}` : <span class="muted">—</span>}</td>
                  {hasResults && <td class="num">{st.wins || ""}</td>}
                  {hasResults && <td class="num">{st.podiums || ""}</td>}
                  {hasAwards && <td class="num">{st.awards.length || ""}</td>}
                </tr>
              ))}
            </tbody>
          </table>
          <p class="empty" id="none" hidden>Aucun résultat.</p>
        </>
      )}
    </div>
  </section>
  <script is:inline>
    {
      const q = document.getElementById("q");
      if (q) {
        const seg = document.getElementById("seg"), rows = [...document.querySelectorAll("#pl tbody tr")], ct = document.getElementById("count"), none = document.getElementById("none");
        let f = "all";
        const run = () => {
          const t = q.value.trim().toLowerCase(); let n = 0;
          for (const tr of rows) { const ok = (!t || tr.dataset.s.includes(t)) && (f === "all" || tr.dataset.f === f); tr.hidden = !ok; if (ok) n++; }
          ct.textContent = `${n} résultat${n > 1 ? "s" : ""}`; none.hidden = n > 0;
        };
        q.addEventListener("input", run);
        seg?.addEventListener("click", (e) => { const b = e.target.closest("button"); if (!b) return; f = b.dataset.f; seg.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", x === b)); run(); });
      }
    }
  </script>
</Base>
