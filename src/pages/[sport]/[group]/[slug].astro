---
import Base from "../../../layouts/Base.astro";
import { SPORTS, POS, getSport, initials, plural, seasonLabel } from "../../../lib/sport.js";
export function getStaticPaths() {
  return SPORTS.flatMap((cfg) => {
    const s = getSport(cfg.key);
    return Object.entries(cfg.groups).flatMap(([g, gc]) => s.groups[g].filter((x) => s.hasPage(x)).map((x) => ({ params: { sport: cfg.key, group: gc.path, slug: x.slug }, props: { id: x.id } })));
  });
}
const s = getSport(Astro.params.sport);
const { cfg } = s;
const x = s.ent.get(Astro.props.id);
const gc = cfg.groups[x.group];
const st = s.stats.get(x.id);
const res = st.results.slice().sort((a, b) => (b.e.start || `${b.e.year}`).localeCompare(a.e.start || `${a.e.year}`) || b.e.year - a.e.year);
const wins = res.filter((r) => s.isWin(r.k));
// victoires par compétition
const byComp = {};
wins.forEach((r) => (byComp[r.e.compId] = (byComp[r.e.compId] || 0) + 1));
const compKeys = Object.keys(byComp).sort((a, b) => byComp[b] - byComp[a]).slice(0, 12);
const cmax = Math.max(1, ...Object.values(byComp));
// par saison
const yrs = res.map((r) => r.e.year);
const seasons = [];
if (yrs.length) for (let y = Math.min(...yrs); y <= Math.max(...yrs); y++) seasons.push(y);
const wy = (y) => wins.filter((r) => r.e.year === y).length;
const wmax = Math.max(1, ...seasons.map(wy));
// distinctions
const awardCounts = {};
st.awards.forEach((a) => (awardCounts[a.label] = (awardCounts[a.label] || 0) + 1));
const usedKeys = Object.keys(POS).filter((k) => st.counts[k]);
const otherGroup = Object.keys(cfg.groups).find((g) => g !== x.group);
const teams = (x.teams || []).map((id) => s.ent.get(id)).filter(Boolean);
// Chiffres clés (le cyclisme a ses propres règles, voir src/sports/config.js)
const kc = cfg.entityKpis || {};
const AW = s.awardWord;
const catWins = (cat) => wins.filter((r) => s.compById.get(r.e.compId)?.category === cat).length;
const kpis = [
  [st.wins, st.wins > 1 ? "victoires" : "victoire", "gold"],
  [st.podiums, st.podiums > 1 ? "podiums" : "podium", ""],
  ...(kc.winsByCategory || []).map(([cat, one, many]) => { const n = catWins(cat); return [n, n > 1 ? many : one, ""]; }),
  ...usedKeys.filter((k) => !POS[k].win && !(kc.hide || []).includes(k)).map((k) => [st.counts[k], POS[k].kpi[st.counts[k] > 1 ? 1 : 0], ""]),
  ...(kc.awardsTotal ? [[st.awards.length, st.awards.length > 1 ? AW.many : AW.one, ""]] : Object.entries(awardCounts).map(([l, n]) => [n, l, ""])),
].filter(([n], i) => (i < 1 && st.results.length) || n > 0);
const showCat = cfg.showCategoryInResults && res.some((r) => s.compById.get(r.e.compId)?.category);
const catOf = (c) => (c?.category && c.category !== "❌" ? c.category : "");
const CAT_ORDER = ["Grand Tour", "Monument", "Championnat", "Tour", "Classique"];
const cats = showCat ? [...new Set(res.map((r) => catOf(s.compById.get(r.e.compId)) || "Autres"))].sort((a, b) => (CAT_ORDER.indexOf(a) + 1 || 99) - (CAT_ORDER.indexOf(b) + 1 || 99)) : [];
const catPlural = { "Grand Tour": "Grands Tours", Monument: "Monuments", Championnat: "Championnats", Tour: "Tours", Classique: "Classiques" };
const posLabel = (k) => POS[k].label;
---
<Base title={x.name} nav={cfg.key} description={`Palmarès : ${x.name}.`}>
  <header class="band hero" style="background:var(--nuit)">
    <div class="wrap">
      <div class={`art${gc.photoKind === "photo" ? " round" : ""}`} style={x.photoBg ? `background:${x.photoBg}` : ""}>{x.photo ? <img src={x.photo} alt={x.name} /> : initials(x.name)}</div>
      <div>
        <div class="crumb"><a href={s.url.home}>{cfg.label}</a> › <a href={s.url.group(x.group)}>{gc.label}</a> › {x.name}</div>
        <h1>{x.name}</h1>
        <div class="tags">
          {x.nat && <span>{x.nat.emoji} {x.nat.name}</span>}
          {Object.values(x.info || {}).map((v) => <span>{v}</span>)}
          {cfg.entities[x.group].retired && <span>{x.retired ? "Retraité" : "En activité"}</span>}
          {teams.map((t) => (s.hasPage(t) ? <a href={s.url.entity(t)}>{t.name}</a> : <span>{t.name}</span>))}
        </div>
      </div>
    </div>
  </header>

  <section class="band">
    <div class="wrap kpis">
      {kpis.map(([n, l, cl]) => <div class={`kpi ${cl}`}><b>{n}</b><span>{l}</span></div>)}
    </div>
  </section>

  {wins.length > 0 && (
    <section class="band flush">
      <div class="wrap cols wide">
        <div>
          <h2>Victoires par {cfg.compWord.one}</h2>
          <p class="sub">Les {cfg.compWord.many} les plus souvent remportées.</p>
          <div class="rows">
            {compKeys.map((id) => { const c = s.compById.get(id); return <div class="r"><span><a href={s.url.comp(c)}>{c.name}</a></span><div class="bar"><i style={`width:${(byComp[id] / cmax) * 100}%;background:${cfg.color}`}></i></div><b>{byComp[id]}</b></div>; })}
          </div>
        </div>
        <div>
          <h2>Victoires par saison</h2>
          <p class="sub">De {seasons[0]} à {seasons.at(-1)}.</p>
          <div class="yrs">
            {seasons.map((y) => { const n = wy(y); return <div title={`${y} : ${plural(n, "victoire")}`}><span>{n || ""}</span><i class="g" style={`height:${(n / wmax) * 85}%`}></i></div>; })}
          </div>
          <div class="yl">{seasons.map((y) => <span>{y % 5 === 0 || y === seasons[0] || y === seasons.at(-1) ? String(y).slice(2) : ""}</span>)}</div>
        </div>
      </div>
    </section>
  )}

  {res.length > 0 && (
    <section class="band flush">
      <div class="wrap">
        <h2>Tous les résultats</h2>
        <p class="sub">Chaque édition où {x.name} figure au classement.</p>
        {(usedKeys.length > 1 || cats.length > 1) && (
          <div class="tools">
            {usedKeys.length > 1 && (
              <div class="seg" id="seg" aria-label="Filtrer par résultat">
                <button data-r="all" aria-pressed="true">Tout</button>
                {usedKeys.map((k) => <button data-r={k} aria-pressed="false">{posLabel(k)}</button>)}
              </div>
            )}
            {cats.length > 1 && (
              <div class="seg" id="segc" aria-label="Filtrer par type de course">
                <button data-c="all" aria-pressed="true">Toutes les courses</button>
                {cats.map((k) => <button data-c={k} aria-pressed="false">{catPlural[k] || k}</button>)}
              </div>
            )}
            <span class="count" id="count">{plural(res.length, "résultat")}</span>
          </div>
        )}
        <table class="stack" id="res">
          <thead><tr><th>Saison</th><th>{cfg.compWord.one[0].toUpperCase() + cfg.compWord.one.slice(1)}</th>{showCat && <th>Type de course</th>}<th>Résultat</th><th>Vainqueur</th></tr></thead>
          <tbody>
            {res.map(({ e, k }) => { const c = s.compById.get(e.compId); const grp = s.groupOfPos(k); const winK = s.usedPositions([e]).find((p) => POS[p].win && s.groupOfPos(p) === grp); return (
              <tr data-r={k} data-c={catOf(c) || "Autres"}>
                <td class="y"><a href={s.url.edition(e)}>{seasonLabel(e)}</a></td>
                <td><a href={s.url.comp(c)}>{c.name}</a></td>
                {showCat && <td>{catOf(c) ? <span class="cat" style={`--cat:${s.compTheme({ category: c.category }).color}`}>{catOf(c)}</span> : <span class="muted">—</span>}</td>}
                <td><span class={`pill ${POS[k].cls}`}>{posLabel(k)}</span></td>
                <td>{POS[k].win ? <span class="muted">—</span> : (e.pos[winK] || []).map((id, j) => { const w = s.ent.get(id); return <>{j > 0 && ", "}<a href={s.url.entity(w)}>{w.name}</a></>; })}</td>
              </tr>
            ); })}
          </tbody>
        </table>
        <p class="empty" id="none" hidden>Aucun résultat pour ce filtre.</p>
      </div>
    </section>
  )}

  {st.awards.length > 0 && (
    <section class="band flush">
      <div class="wrap">
        <h2>{AW.title}</h2>
        <p class="sub">{plural(st.awards.length, AW.one, AW.many)}{cfg.awardWord ? "" : ` individuelle${st.awards.length > 1 ? "s" : ""}`}.</p>
        <table class="stack" style="max-width:860px">
          <thead><tr><th>Saison</th><th>{cfg.compWord.one[0].toUpperCase() + cfg.compWord.one.slice(1)}</th><th>{AW.col}</th></tr></thead>
          <tbody>
            {st.awards.slice().sort((a, b) => b.e.year - a.e.year).map(({ e, label }) => { const c = s.compById.get(e.compId); return (
              <tr><td class="y"><a href={s.url.edition(e)}>{seasonLabel(e)}</a></td><td><a href={s.url.comp(c)}>{c.name}</a></td><td>{label}</td></tr>
            ); })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {res.length === 0 && st.awards.length === 0 && (
    <section class="band flush"><div class="wrap"><p class="muted">Aucun résultat n'est encore relié à cette fiche dans Notion.</p></div></section>
  )}
  <script is:inline>
    {
      // deux filtres qui se combinent : résultat et type de course
      const rows = [...document.querySelectorAll("#res tbody tr")], ct = document.getElementById("count"), none = document.getElementById("none");
      const f = { r: "all", c: "all" };
      const apply = () => {
        let n = 0;
        for (const tr of rows) { const ok = (f.r === "all" || tr.dataset.r === f.r) && (f.c === "all" || tr.dataset.c === f.c); tr.hidden = !ok; if (ok) n++; }
        ct.textContent = `${n} résultat${n > 1 ? "s" : ""}`; none.hidden = n > 0;
      };
      for (const [id, key] of [["seg", "r"], ["segc", "c"]]) {
        const seg = document.getElementById(id); if (!seg) continue;
        seg.addEventListener("click", (ev) => {
          const b = ev.target.closest("button"); if (!b) return;
          seg.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", x === b));
          f[key] = b.dataset[key]; apply();
        });
      }
    }
  </script>
</Base>
