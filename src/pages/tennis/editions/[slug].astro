---
import Base from "../../../layouts/Base.astro";
import { roundLabels, isOlympic, isGroupStage, heroBg, editions, editionsByComp, compById, playerById, surf, catLabel, initials, url, frDate } from "../../../lib/tennis.js";
export function getStaticPaths() {
  return editions.map((e) => ({ params: { slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
const c = compById.get(e.compId);
const list = editionsByComp.get(c.id);
const i = list.indexOf(e);
const prev = list[i + 1], next = list[i - 1];
const S = surf(e.surface || c.surface);
const P = (id) => playerById.get(id);
const RL = roundLabels(c);
const olympic = isOlympic(c);
const bronze = new Set(e.b || []);
const cols = [[RL.qfCol, e.qf, false, "qf"], ["Demi-finales", e.sf, false, "sf"], [RL.fCol, e.f, false, "f"], [RL.vCol, e.v, true, "v"]].filter(([, ids, win]) => win || ids.length > 0);
const medal = (k, id) => (!olympic ? null : k === "v" ? "or" : k === "f" ? "argent" : k === "sf" && bronze.has(id) ? "bronze" : null);
const dates = e.start ? (e.end ? `Du ${frDate(e.start)} au ${frDate(e.end, true)}` : `Le ${frDate(e.start, true)}`) : null;
---
<Base title={`${c.name} ${e.year}`} nav="tournois" description={`Tableau final de ${c.name} ${e.year}.`}>
  <header class="band hero" style={heroBg(c, S)}>
    <div class="wrap">
      <div class="art" style={c.logoBg ? `background:${c.logoBg}` : ""}>{c.logo ? <img src={c.logo} alt={`Logo ${c.name}`} /> : initials(c.name)}</div>
      <div>
        <div class="crumb"><a href="/tennis/">Tennis</a> › <a href={url.comp(c)}>{c.name}</a> › {e.year}</div>
        <h1>{c.name} {e.year}</h1>
        {dates && <p>{dates}.</p>}
        <div class="tags">
          {S.known && <span>{S.label}</span>}
          {e.category && <span>{catLabel(e.category)}</span>}
          {e.name !== c.name && <span>Nom cette année-là : {e.name}</span>}
          <a href={url.comp(c)}>Toutes les éditions</a>
        </div>
      </div>
    </div>
  </header>
  <section class="band">
    <div class="wrap">
      <h2>Tableau final</h2>
      <p class="sub">{e.qf.length ? (isGroupStage(c) ? "De la phase de groupe au titre." : "Des quarts au titre.") : e.sf.length ? "Des demi-finales au titre." : "La finale."} Chaque nom ouvre la fiche du joueur.{olympic && bronze.size > 0 && " Le rond de bronze indique le vainqueur du match pour la 3e place."}</p>
      <div class="draw" style={`--cols:${cols.length}`}>
        {cols.map(([title, ids, win, k]) => (
          <div class="col">
            <h3>{title}</h3>
            {ids.map((id) => (
              <div class={`slot${win ? " win" : ""}`}>
                <span class="mini">{P(id).photo ? <img src={P(id).photo} alt="" loading="lazy" /> : initials(P(id).name)}</span>
                <a href={url.player(P(id))}>{P(id).name}</a>
                {medal(k, id) && <i class={`medal ${medal(k, id)}`} title={`Médaille ${medal(k, id) === "or" ? "d'or" : medal(k, id) === "argent" ? "d'argent" : "de bronze"}`} style="margin-left:auto"></i>}
              </div>
            ))}
          </div>
        ))}
      </div>
      <nav class="pager" aria-label="Éditions voisines">
        {prev ? <a href={url.edition(prev)}>‹ Édition {prev.year}</a> : <span></span>}
        {next && <a href={url.edition(next)}>Édition {next.year} ›</a>}
      </nav>
    </div>
  </section>
</Base>
