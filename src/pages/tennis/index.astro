---
import Base from "../../layouts/Base.astro";
import { compColor, competitions, editions, players, groupCompetitions, statsById, compById, playerById, surf, initials, url, plural, fsInfo } from "../../lib/tennis.js";
const groups = groupCompetitions();
const top = players.map((p) => ({ p, s: statsById.get(p.id) })).filter((x) => x.s.titles).sort((a, b) => b.s.gc - a.s.gc || b.s.titles - a.s.titles).slice(0, 10);
const recent = editions.filter((e) => e.v.length).slice(0, 8);
const maxT = Math.max(1, ...top.map((x) => x.s.titles));
---
<Base title="Tennis" nav="tennis">
  <header class="band hero noart" style="background:#24476b">
    <div class="wrap">
      <div>
        <div class="crumb"><a href="/">Portail des sports</a> › Tennis</div>
        <h1>Tennis</h1>
        <p>Tournois, éditions et joueurs. Chaque nom ouvre sa fiche.</p>
        <div class="tags"><span>{plural(competitions.length, "tournoi")}</span><span>{plural(editions.length, "édition")}</span><span>{plural(players.length, "joueur")}</span></div>
      </div>
    </div>
  </header>

  <section class="band">
    <div class="wrap cols">
      <div>
        <h2>Dernières éditions</h2>
        <p class="sub">Les tournois les plus récents de la base.</p>
        <table class="stack">
          <thead><tr><th>Édition</th><th>Vainqueur</th><th>Finaliste</th></tr></thead>
          <tbody>
            {recent.map((e) => (
              <tr>
                <td><a href={url.edition(e)}>{e.name} {e.year}</a></td>
                <td>{e.v.map((id, i) => <>{i > 0 && ", "}<a href={url.player(playerById.get(id))}>{playerById.get(id).name}</a></>)}{fsInfo(e) && <small class="fs" title={fsInfo(e).text}>{fsInfo(e).short}</small>}</td>
                <td>{e.f.map((id, i) => <>{i > 0 && ", "}<a href={url.player(playerById.get(id))}>{playerById.get(id).name}</a></>)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div>
        <h2>Les plus titrés</h2>
        <p class="sub">Classés par titres du Grand Chelem, puis par titres au total.</p>
        <div class="rows">
          {top.map(({ p, s }) => (
            <div class="r"><span><a href={url.player(p)}>{p.name}</a></span><div class="bar"><i style={`width:${(s.gc / maxT) * 100}%;background:var(--or)`}></i><i style={`width:${((s.titles - s.gc) / maxT) * 100}%;background:light-dark(var(--nuit),#5b78c2)`}></i></div><b>{s.titles}</b></div>
          ))}
        </div>
        <div class="legend" style="margin-top:12px"><span><i style="background:var(--or)"></i>Grands Chelems</span><span><i style="background:light-dark(var(--nuit),#5b78c2)"></i>Autres titres</span></div>
        <p><a href={url.players}>Tous les joueurs ›</a> · <a href={url.records}>Records et exploits ›</a></p>
      </div>
    </div>
  </section>

  <section class="band flush" id="tournois">
    <div class="wrap">
      <h2>Tournois</h2>
      <p class="sub">Classés comme dans ta base Notion.</p>
      <div class="tools">
        <input type="search" id="qt" placeholder="Chercher un tournoi ou une ville" aria-label="Chercher un tournoi ou une ville" />
        <span class="count" id="ct">{competitions.length} tournois</span>
      </div>
      <p class="empty" id="nt" hidden>Aucun tournoi ne correspond.</p>
      {groups.map((g) => (
        <>
          <div class="tgroup">
          <h3 style="font-size:24px;margin:22px 0 12px">{g.title}</h3>
          {g.history && <p class="cat-hist">Anciens noms : {g.history.slice(0, -2).map(([y, n]) => <span>{n} <small>({y})</small></span>)}</p>}
          <div class="grid">
            {g.items.map((c) => (
              <a class="card" href={url.comp(c)} data-s={`${c.name} ${c.city || ""} ${c.zone?.name || ""}`.toLowerCase()}>
                <div class="pic" style={`background:${compColor(c)}`}>{c.logo ? <img src={c.logo} alt="" loading="lazy" /> : initials(c.name)}</div>
                <div class="body">
                  <h3>{c.name}</h3>
                  {c.surface && <span class="chip"><i class="dot" style={`background:${surf(c.surface).color}`}></i>{surf(c.surface).label}</span>}
                </div>
              </a>
            ))}
          </div>
          </div>
        </>
      ))}
    </div>
  </section>
  <script is:inline>
    {
      const q = document.getElementById("qt"), ct = document.getElementById("ct"), none = document.getElementById("nt");
      const groups = [...document.querySelectorAll(".tgroup")];
      const norm = (t) => t.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
      q.addEventListener("input", () => {
        const t = norm(q.value.trim()); let n = 0;
        for (const g of groups) {
          let k = 0;
          for (const a of g.querySelectorAll("a.card")) { const ok = !t || norm(a.dataset.s).includes(t); a.hidden = !ok; if (ok) k++; }
          g.hidden = k === 0; n += k;
        }
        ct.textContent = `${n} tournoi${n > 1 ? "s" : ""}`; none.hidden = n > 0;
      });
    }
  </script>
</Base>
