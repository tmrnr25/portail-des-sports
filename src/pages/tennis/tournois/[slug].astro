---
import Base from "../../../layouts/Base.astro";
import { heroBg, competitions, editionsByComp, playerById, surf, initials, url, plural } from "../../../lib/tennis.js";
export function getStaticPaths() {
  return competitions.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const eds = editionsByComp.get(c.id) || [];
const P = (id) => playerById.get(id);
const W = {}, F = {};
eds.forEach((e) => { e.v.forEach((p) => (W[p] = (W[p] || 0) + 1)); e.f.forEach((p) => (F[p] = (F[p] || 0) + 1)); });
const top = Object.keys(W).sort((a, b) => W[b] - W[a] || (F[b] || 0) - (F[a] || 0)).slice(0, 10);
const best = top[0];
// Record : tous les joueurs à égalité au nombre de titres maximum
const recordMax = best ? W[best] : 0;
const span = (ys) => (ys.length > 1 ? `${ys[0]}–${ys.at(-1)}` : `${ys[0]}`);
const holders = Object.keys(W).filter((id) => W[id] === recordMax)
  .map((id) => ({ id, years: eds.filter((e) => e.v.includes(id)).map((e) => e.year).sort((a, b) => a - b) }))
  .sort((a, b) => a.years[0] - b.years[0]);
const neverWon = Object.keys(F).filter((p) => !W[p]).length;
const first = eds.at(-1), last = eds[0];
const mx = Math.max(1, ...top.map((p) => W[p] + (F[p] || 0)));
// par décennie
const dec = {};
eds.forEach((e) => { const d = Math.floor(e.year / 10) * 10; dec[d] = dec[d] || { tot: 0, w: {} }; dec[d].tot++; e.v.forEach((p) => (dec[d].w[p] = (dec[d].w[p] || 0) + 1)); });
const decades = Object.keys(dec).sort().map((d) => {
  const w = dec[d].w, ks = Object.keys(w); const m = Math.max(0, ...ks.map((k) => w[k]));
  return { d, m, tot: dec[d].tot, names: ks.filter((k) => w[k] === m) };
});
const S = surf(c.surface);
const cityLines = (c.city || "").split("\n").map((s) => s.trim()).filter(Boolean);
// Colonnes du tableau : on ne garde que les tours renseignés au moins une fois
const COLS = [["v", "Vainqueur"], ["f", "Finaliste"], ["sf", "Demi-finalistes"], ["qf", "Quart-de-finalistes"]].filter(([k]) => k === "v" || eds.some((e) => e[k].length));
// Historique des surfaces (d'après la surface de chaque édition)
const surfRuns = [];
eds.slice().reverse().forEach((e) => {
  const sf = e.surface || c.surface; if (!sf) return;
  const last = surfRuns.at(-1);
  if (last && last.s === sf) last.to = e.year; else surfRuns.push({ s: sf, from: e.year, to: e.year });
});
const surfHistory = surfRuns.length > 1 ? surfRuns.slice().reverse().map((r, i) => (i === 0 ? `Depuis ${r.from} : ${surf(r.s).label}` : r.from === r.to ? `${r.from} : ${surf(r.s).label}` : `${r.from}-${r.to} : ${surf(r.s).label}`)) : [];
const surfChanged = surfRuns.length > 1;
const search = (e) => [e.year, ...[...e.v, ...e.f, ...e.sf, ...e.qf].map((id) => P(id).name)].join(" | ").toLowerCase();
---
<Base title={c.name} nav="tournois" description={`Palmarès et éditions de ${c.name}.`}>
  <header class="band hero" style={heroBg(c, S)}>
    <div class="wrap">
      <div class="art" style={c.logoBg ? `background:${c.logoBg}` : ""}>{c.logo ? <img src={c.logo} alt={`Logo ${c.name}`} /> : initials(c.name)}</div>
      <div>
        <div class="crumb"><a href="/tennis/">Tennis</a> › <a href="/tennis/#tournois">Tournois</a> › {c.name}</div>
        <h1>{c.name}</h1>
        <div class="tags">
          {c.category && <span>{c.category}</span>}
          {S.known && <span>{S.label}</span>}
          {cityLines[0] && <span>{cityLines[0]}</span>}
          {c.zone && <span>{c.zone.emoji} {c.zone.name}</span>}
          {c.created && <span>Créé en {c.created}</span>}
          {c.disappeared && <span>Disparu en {c.disappeared}</span>}
        </div>
        {cityLines.length > 1 && <p style="font-size:14px">Lieu : {cityLines.slice(1).join(" · ")}</p>}
        {surfHistory.length > 0 && <p style="font-size:14px">Surface : {surfHistory.join(" · ")}</p>}
      </div>
      {best && (
        <div class="record">
          <small>Record de titres{holders.length > 1 && ` · ${holders.length} à égalité`}</small>
          <b>{recordMax}</b>
          {holders.length === 1 ? (
            <><a href={url.player(P(holders[0].id))}>{P(holders[0].id).name}</a><small>{holders[0].years.length > 1 ? `de ${holders[0].years[0]} à ${holders[0].years.at(-1)}` : `en ${holders[0].years[0]}`}</small></>
          ) : (
            <ul class="holders">{holders.map((h) => <li><a href={url.player(P(h.id))}>{P(h.id).name}</a> <small>{span(h.years)}</small></li>)}</ul>
          )}
        </div>
      )}
    </div>
  </header>

  <section class="band">
    <div class="wrap kpis">
      <div class="kpi"><b>{eds.length}</b><span>{eds.length > 1 ? "éditions" : "édition"}{first && ` (${first.year}–${last.year})`}</span></div>
      <div class="kpi"><b>{Object.keys(W).length}</b><span>vainqueurs différents</span></div>
      {last && last.v.length > 0 && <div class="kpi gold"><b style="font-size:24px;line-height:1.2">{last.v.map((id, i) => <>{i > 0 && ", "}<a href={url.player(P(id))}>{P(id).name}</a></>)}</b><span>vainqueur <a href={url.edition(last)}>{last.year}</a></span></div>}
      <div class="kpi"><b>{neverWon}</b><span>finalistes jamais titrés</span></div>
    </div>
  </section>

  {top.length > 0 && (
    <section class="band flush">
      <div class="wrap cols">
        <div>
          <h2>Les plus titrés</h2>
          <p class="sub">Titres et finales perdues.</p>
          <div class="legend"><span><i style={`background:${S.color}`}></i>Titres</span><span><i style={`background:color-mix(in srgb,${S.color} 40%,#fff)`}></i>Finales perdues</span></div>
          <div class="rows">
            {top.map((p) => (
              <div class="r"><span><a href={url.player(P(p))}>{P(p).name}</a></span><div class="bar"><i style={`width:${(W[p] / mx) * 100}%;background:${S.color}`}></i><i style={`width:${((F[p] || 0) / mx) * 100}%;background:color-mix(in srgb,${S.color} 40%,#fff)`}></i></div><b>{W[p]}</b></div>
            ))}
          </div>
        </div>
        <div>
          <h2>Par décennie</h2>
          <p class="sub">Le ou les vainqueurs les plus titrés (titres sur éditions jouées).</p>
          <div class="rows">
            {decades.map((x) => (
              <div class="r"><span>Années {String(x.d).slice(2)} · {x.names.map((id, i) => <>{i > 0 && " / "}<a href={url.player(P(id))}>{P(id).name}</a></>)}</span><div class="bar"><i style={`width:${(x.m / x.tot) * 100}%;background:${S.color}`}></i></div><b>{x.m}/{x.tot}</b></div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="band flush">
    <div class="wrap">
      <h2>Toutes les éditions</h2>
      <p class="sub">L'année ouvre le tableau final de l'édition, chaque nom la fiche du joueur.</p>
      <div class="tools">
        <input type="search" id="q" placeholder="Chercher un joueur ou une année" aria-label="Chercher un joueur ou une année" />
        <span class="count" id="count">{plural(eds.length, "édition")}</span>
      </div>
      <table class="stack" id="eds">
        <thead><tr><th>Année</th>{surfChanged && <th>Surface</th>}{COLS.map(([, l]) => <th>{l}</th>)}</tr></thead>
        <tbody>
          {eds.map((e) => (
            <tr data-s={search(e)}>
              <td class="y"><a href={url.edition(e)}>{e.year}</a></td>
              {surfChanged && <td><span class="chip"><i class="dot" style={`background:${surf(e.surface || c.surface).color}`}></i>{surf(e.surface || c.surface).label}</span></td>}
              {COLS.map(([k]) => <td>{e[k].map((id, i) => <>{i > 0 && <br />}<a href={url.player(P(id))}>{P(id).name}</a></>)}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
      <p class="empty" id="none" hidden>Aucune édition ne correspond.</p>
    </div>
  </section>
  <script is:inline>
    {
      const q = document.getElementById("q"), rows = [...document.querySelectorAll("#eds tbody tr")], ct = document.getElementById("count"), none = document.getElementById("none");
      const run = () => {
        const t = q.value.trim().toLowerCase(); let n = 0;
        for (const r of rows) { const ok = !t || r.dataset.s.includes(t); r.hidden = !ok; if (ok) n++; }
        ct.textContent = t ? `${n} édition${n > 1 ? "s" : ""} sur ${rows.length}` : `${rows.length} édition${rows.length > 1 ? "s" : ""}`;
        none.hidden = n > 0;
      };
      q.addEventListener("input", run);
    }
  </script>
</Base>
