---
import Base from "../../../layouts/Base.astro";
import { players, statsById, url, plural } from "../../../lib/tennis.js";
const rows = players
  .map((p) => ({ p, s: statsById.get(p.id) }))
  .sort((a, b) => b.s.gc - a.s.gc || b.s.titles - a.s.titles || b.s.lostFinals - a.s.lostFinals || a.p.name.localeCompare(b.p.name, "fr"));
---
<Base title="Joueurs" nav="joueurs" description="Tous les joueurs de tennis de la base.">
  <header class="band hero noart" style="background:var(--nuit)">
    <div class="wrap">
      <div>
        <div class="crumb"><a href="/tennis/">Tennis</a> › Joueurs</div>
        <h1>Joueurs</h1>
        <p>{plural(players.length, "joueur")}, classés par titres du Grand Chelem puis par titres au total.</p>
      </div>
    </div>
  </header>
  <section class="band">
    <div class="wrap">
      <div class="tools">
        <input type="search" id="q" placeholder="Chercher un joueur ou un pays" aria-label="Chercher un joueur ou un pays" />
        <div class="seg" id="seg">
          <button data-f="all" aria-pressed="true">Tous</button>
          <button data-f="actif" aria-pressed="false">En activité</button>
          <button data-f="retraite" aria-pressed="false">Retraités</button>
        </div>
        <span class="count" id="count">{plural(players.length, "joueur")}</span>
      </div>
      <table class="stack" id="pl">
        <thead><tr><th>Joueur</th><th>Pays</th><th class="num">Grands Chelems</th><th class="num">Titres</th><th class="num">Finales perdues</th><th class="num">Meilleur classement</th></tr></thead>
        <tbody>
          {rows.map(({ p, s }) => (
            <tr data-s={`${p.name} ${p.nat?.name || ""}`.toLowerCase()} data-f={p.retired ? "retraite" : "actif"}>
              <td><a href={url.player(p)}>{p.name}</a></td>
              <td>{p.nat ? `${p.nat.emoji} ${p.nat.name}` : <span class="muted">—</span>}</td>
              <td class="num">{s.gc || ""}</td>
              <td class="num">{s.titles || ""}</td>
              <td class="num">{s.lostFinals || ""}</td>
              <td class="num">{p.best ? `n° ${p.best}` : ""}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="empty" id="none" hidden>Aucun joueur ne correspond.</p>
    </div>
  </section>
  <script is:inline>
    {
      const q = document.getElementById("q"), seg = document.getElementById("seg"), rows = [...document.querySelectorAll("#pl tbody tr")], ct = document.getElementById("count"), none = document.getElementById("none");
      let f = "all";
      const run = () => {
        const t = q.value.trim().toLowerCase(); let n = 0;
        for (const tr of rows) { const ok = (!t || tr.dataset.s.includes(t)) && (f === "all" || tr.dataset.f === f); tr.hidden = !ok; if (ok) n++; }
        ct.textContent = `${n} joueur${n > 1 ? "s" : ""}`; none.hidden = n > 0;
      };
      q.addEventListener("input", run);
      seg.addEventListener("click", (e) => { const b = e.target.closest("button"); if (!b) return; f = b.dataset.f; seg.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", x === b)); run(); });
    }
  </script>
</Base>
